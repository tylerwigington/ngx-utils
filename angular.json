{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "ngx-serial-route-guards": {
      "projectType": "library",
      "root": "projects/ngx-serial-route-guards",
      "sourceRoot": "projects/ngx-serial-route-guards/src",
      "prefix": "lib",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:ng-packagr",
          "options": {
            "project": "projects/ngx-serial-route-guards/ng-package.json"
          },
          "configurations": {
            "production": {
              "tsConfig": "projects/ngx-serial-route-guards/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "projects/ngx-serial-route-guards/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "tsConfig": "projects/ngx-serial-route-guards/tsconfig.spec.json",
            "polyfills": ["zone.js", "zone.js/testing"],
            "codeCoverage": true,
            "browsers": "ChromeHeadless",
            "watch": false
          }
        }
      }
    },
    "ngx-ionic-file-upload": {
      "projectType": "library",
      "root": "projects/ngx-ionic-file-upload",
      "sourceRoot": "projects/ngx-ionic-file-upload/src",
      "prefix": "lib",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:ng-packagr",
          "options": {
            "project": "projects/ngx-ionic-file-upload/ng-package.json"
          },
          "configurations": {
            "production": {
              "tsConfig": "projects/ngx-ionic-file-upload/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "projects/ngx-ionic-file-upload/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "tsConfig": "projects/ngx-ionic-file-upload/tsconfig.spec.json",
            "polyfills": ["zone.js", "zone.js/testing"],
            "codeCoverage": true,
            "browsers": "ChromeHeadless",
            "watch": false
          }
        }
      }
    },
    "ngx-ionic-file-upload-demo": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss"
        }
      },
      "root": "projects/ngx-ionic-file-upload-demo",
      "sourceRoot": "projects/ngx-ionic-file-upload-demo/src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:application",
          "options": {
            "outputPath": "dist/ngx-ionic-file-upload-demo",
            "index": "projects/ngx-ionic-file-upload-demo/src/index.html",
            "browser": "projects/ngx-ionic-file-upload-demo/src/main.ts",
            "polyfills": ["zone.js"],
            "tsConfig": "projects/ngx-ionic-file-upload-demo/tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              {
                "glob": "**/*",
                "input": "projects/ngx-ionic-file-upload-demo/public"
              }
            ],
            "styles": [
              "projects/ngx-ionic-file-upload-demo/src/styles.scss",
              "projects/ngx-ionic-file-upload-demo/src/theme.scss"
            ],
            "scripts": []
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "4kB",
                  "maximumError": "8kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular-devkit/build-angular:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "ngx-ionic-file-upload-demo:build:production"
            },
            "development": {
              "buildTarget": "ngx-ionic-file-upload-demo:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "extract-i18n": {
          "builder": "@angular-devkit/build-angular:extract-i18n"
        },
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "polyfills": ["zone.js", "zone.js/testing"],
            "tsConfig": "projects/ngx-ionic-file-upload-demo/tsconfig.spec.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              {
                "glob": "**/*",
                "input": "projects/ngx-ionic-file-upload-demo/public"
              }
            ],
            "styles": ["projects/ngx-ionic-file-upload-demo/src/styles.scss"],
            "scripts": []
          }
        }
      }
    }
  }
}
